# MySQL / MariaDB (XAMPP defaults). The database is created automatically on first request.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tcaps

# Optional: HMAC key for the signed session cookie (generated once into data/.session-secret when omitted).
SESSION_SECRET=
# Optional: password for the first-run owner account (a random one is printed to the console when omitted).
OWNER_PASSWORD=

# Set to false only when running a production build over plain http (e.g. local testing); keep unset behind HTTPS.
COOKIE_SECURE=

